# Optional Telegram integration. Leave blank for browser-only demo mode.
TELEGRAM_BOT_TOKEN=
# Optional: numeric Telegram user ID. If blank, use the one-time link printed by start-bot.ps1.
DOCTOR_USER_ID=

# Bot -> backend connection (defaults work when everything runs locally).
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_REQUEST_BYTES=262144

# Enables the dashboard's "simulate doctor reply" endpoint.
DEMO_MODE=true
